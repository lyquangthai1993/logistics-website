{
  "name": "Webhook to Telegram - Hello World",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hello-telegram",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "id": "webhook-trigger-node",
      "name": "Webhook Trigger"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.body?.chat_id || \"\" }}",
        "text": "Hello World! 🚀 Được gửi tự động từ n8n qua Webhook.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [460, 300],
      "id": "telegram-send-node",
      "name": "Telegram - Send Hello World"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Hello World đã được gửi tới Telegram!\",\n  \"received\": \"={{ $json }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300],
      "id": "respond-to-webhook-node",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Telegram - Send Hello World",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram - Send Hello World": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
