{
  "id": "M1IVf9rAsyFD5TYq",
  "name": "Logistics TMS - Daily RBAC & Security Audit 22:00 PM",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 22 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "id": "schedule-trigger-10pm",
      "name": "Schedule: 10:00 PM Hàng Ngày"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst dateStr = now.toLocaleDateString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\nconst timeStr = now.toLocaleTimeString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\n\nconst initText = `<b>🛡️ N8N CRON: KHỞI CHẠY AUDIT RBAC & BẢO MẬT (22:00)</b>\\n` +\n  `━━━━━━━━━━━━━━━━━━━━\\n` +\n  `⏰ <b>Thời gian kích hoạt:</b> ${timeStr} - ${dateStr}\\n` +\n  `⚡ <b>Mục tiêu:</b> Rà soát 7 ngày biến động trong <code>SYSTEM_TIMELINE.md</code> & Đối soát 59 API endpoints với RBAC Matrix.\\n` +\n  `🚀 <b>Điều phối:</b> Kích hoạt tự động GitHub Actions CI/CD và Script Auditor.`;\n\nreturn [{\n  json: {\n    chat_id: '-5509877448',\n    text: initText,\n    parse_mode: 'HTML',\n    timestamp: now.toISOString(),\n    cron: '0 22 * * *'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "id": "prepare-audit-payload",
      "name": "Chuẩn Bị Payload & Lịch Trình"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8676574641:AAGKfr1V4sZVA4DSooyIvfziggvUGS-7HyE/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.chat_id }}\",\n  \"text\": \"{{ $json.text }}\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "id": "telegram-start-notify",
      "name": "Thông Báo Telegram Bắt Đầu"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/lyquangthai1993/logistics-website/dispatches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-Automation-TMS"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"rbac-audit\",\n  \"client_payload\": {\n    \"task_id\": \"n8n-daily-rbac-22pm\",\n    \"sender_name\": \"n8n Scheduler\",\n    \"mode\": \"rbac\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400],
      "id": "trigger-github-workflow",
      "name": "Kích Hoạt GitHub Actions Worker"
    }
  ],
  "connections": {
    "Schedule: 10:00 PM Hàng Ngày": {
      "main": [
        [
          {
            "node": "Chuẩn Bị Payload & Lịch Trình",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chuẩn Bị Payload & Lịch Trình": {
      "main": [
        [
          {
            "node": "Thông Báo Telegram Bắt Đầu",
            "type": "main",
            "index": 0
          },
          {
            "node": "Kích Hoạt GitHub Actions Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Ho_Chi_Minh",
    "saveManualExecutions": true
  }
}
