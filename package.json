{
  "name": "logistics-website",
  "version": "1.0.0",
  "description": "Logistics TMS - monorepo root scripts (backend + frontend)",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "backend": "npm run start:dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix tools/telegram-task-runner",
    "repo:status": "git status -sb && git -C backend status -sb && git -C frontend status -sb",
    "repo:tracking": "git branch -vv && git -C backend branch -vv && git -C frontend branch -vv",
    "test:e2e": "npm run e2e --prefix frontend",
    "test:e2e:check": "npm run e2e:check --prefix frontend",
    "test:e2e:report": "npm run e2e:report --prefix frontend",
    "e2e:audit": "node scripts/e2e-auditor.mjs",
    "telegram:bot": "node tools/telegram-task-runner/bot.mjs",
    "telegram:worker": "node tools/telegram-task-runner/neon-worker.mjs",
    "telegram:worker:dev": "node --watch-path=tools/telegram-task-runner tools/telegram-task-runner/neon-worker.mjs",
    "todo:scan": "node scripts/todo-agent.mjs scan",
    "todo:today": "node scripts/todo-agent.mjs today",
    "todo:inspect": "node scripts/todo-agent.mjs inspect",
    "todo:plan": "node scripts/todo-agent.mjs plan",
    "todo:record": "node scripts/todo-agent.mjs record",
    "todo:timeline": "node scripts/todo-agent.mjs timeline"
  },
  "devDependencies": {
    "docx": "^9.7.1"
  }
}
