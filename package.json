{
  "name": "logistics-website",
  "version": "1.1.1",
  "description": "Logistics TMS - monorepo root scripts (backend + frontend)",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:ensure": "node scripts/ensure-local-servers.mjs ensure",
    "dev:status": "node scripts/ensure-local-servers.mjs status",
    "dev:stop": "node scripts/ensure-local-servers.mjs stop",
    "backend": "npm run start:dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix tools/telegram-task-runner",
    "repo:status": "git status -sb && git -C backend status -sb && git -C frontend status -sb",
    "repo:tracking": "git branch -vv && git -C backend branch -vv && git -C frontend branch -vv",
    "repo:sync": "node scripts/repo-sync.mjs",
    "test:e2e": "npm run e2e --prefix frontend",
    "test:e2e:check": "npm run e2e:check --prefix frontend",
    "test:e2e:report": "npm run e2e:report --prefix frontend",
    "e2e:audit": "node scripts/e2e-auditor.mjs",
    "audit:rbac": "node scripts/audit-rbac-daily.mjs",
    "telegram:bot": "node tools/telegram-task-runner/bot.mjs",
    "telegram:worker": "node tools/telegram-task-runner/neon-worker.mjs",
    "telegram:worker:dev": "node --watch-path=tools/telegram-task-runner tools/telegram-task-runner/neon-worker.mjs",
    "task:pending": "node scripts/query-incomplete-tasks.mjs",
    "task:progress": "node scripts/check-in-progress.mjs",
    "task:retry": "node scripts/task-retry.mjs",
    "task:branch": "node scripts/git-task-workflow.mjs start",
    "task:pr": "node scripts/git-task-workflow.mjs pr",
    "task:git": "node scripts/git-task-workflow.mjs",
    "report:today": "node scripts/report-today.mjs",
    "report:today:send": "node scripts/report-today.mjs --send",
    "todo:scan": "node scripts/todo-agent.mjs scan",
    "todo:today": "node scripts/todo-agent.mjs today",
    "todo:inspect": "node scripts/todo-agent.mjs inspect",
    "todo:plan": "node scripts/todo-agent.mjs plan",
    "todo:record": "node scripts/todo-agent.mjs record",
    "todo:timeline": "node scripts/todo-agent.mjs timeline",
    "deploy:railway": "node scripts/railway-deploy.mjs",
    "deploy:railway:backend": "node scripts/railway-deploy.mjs backend",
    "deploy:railway:frontend": "node scripts/railway-deploy.mjs frontend",
    "hooks:railway": "node scripts/install-railway-hooks.mjs",
    "exec:timeout": "node scripts/hooks/timeout-runner.mjs 300",
    "db:sync:prod-to-dev": "node scripts/railway-db-sync.mjs",
    "db:dump:prod": "node scripts/railway-db-sync.mjs --dump-only",
    "order:audit": "node scripts/order-audit-agent.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "docx": "^9.7.1"
  }
}
